#!/bin/sh
### BEGIN INIT INFO
# Provides:          iq_forge
# Required-Start:    $all
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Load FPGA bitstream + apply AD9361 overlay persisted by
#                     iq_forge_fw scripts/load.sh --persistent
### END INIT INFO

IQ_FORGE_DIR="/opt/iq_forge/current"

case "$1" in
  start)
    if [ ! -f "$IQ_FORGE_DIR/manifest.env" ]; then
        echo "iq_forge: nothing deployed in $IQ_FORGE_DIR, skipping"
        exit 0
    fi

    cd "$IQ_FORGE_DIR" || exit 0
    # Backgrounded: iq_forge_app now stays running forever (it hosts a TCP
    # control server, see iq_forge_fw's control_server.h) instead of
    # exiting right after bring-up like it used to -- running it in the
    # foreground here would hang boot at this init step.
    ./iq_forge_app > /var/log/iq_forge_app.log 2>&1 &
    ;;
  stop)
    ;;
  restart|reload|force-reload)
    ;;
  *)
    echo "Usage: $0 start" >&2
    exit 3
    ;;
esac

exit 0
