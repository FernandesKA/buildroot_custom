CONFIG_SPL_SERIAL=y
CONFIG_SPL_DM_SERIAL=y
CONFIG_SPL_DM=y
CONFIG_SPL_OF_CONTROL=y
CONFIG_SPL_LIBCOMMON_SUPPORT=y
CONFIG_SPL_LIBGENERIC_SUPPORT=y
CONFIG_SPL_OF_LIST="zynq-rk7020f-ad"
CONFIG_SPL_FS_FAT=y
CONFIG_SPL_MMC=y
CONFIG_SPL_OS_BOOT=n
CONFIG_ENV_IS_IN_FAT=n
CONFIG_ENV_FAT_INTERFACE=n
CONFIG_ENV_IS_NOWHERE=y

# Load the PL bitstream from the boot FAT partition before the kernel
# boots - the axi_ad9361/dmac/sysid nodes in the devicetree only work
# once the fabric is actually configured.
#
# blocksize (5th arg) MUST be the exact bitstream size, not 0: zynq_loadfs()
# forwards this value as-is (not the actual fs_read() byte count) into
# zynq_validate_bitstream() -> check_data(), which scans exactly that many
# bytes for the sync word. 0 means "read whole file" for the fs_read() call
# itself, but a zero-length window means check_data() never finds the sync
# word and validation always fails. 4045564 is the fixed raw/uncompressed
# bitstream size for the XC7Z020 (must match `fpga info 0` "Device Size" -
# same value for any bitstream targeting this chip, not project-specific).
CONFIG_FPGA=y
CONFIG_FPGA_XILINX=y
CONFIG_FPGA_ZYNQPL=y
CONFIG_CMD_FPGA=y
CONFIG_CMD_FPGA_LOADFS=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="if fpga loadfs 0 0x2000000 0x800000 4045564 mmc 0:1 system.bit.bin; then echo FPGA: bitstream loaded; else echo FPGA: system.bit.bin not found on boot partition, PL peripherals will not work; fi"
