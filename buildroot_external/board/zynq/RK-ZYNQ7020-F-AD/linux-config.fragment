# SPI
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_XILINX=y
CONFIG_SPI_BITBANG=y
CONFIG_SPI_SPIDEV=y

# I2C (AD9361/FMCOMMS2-3 EEPROM + AD7291 temp/voltage monitor on i2c1)
CONFIG_I2C=y
CONFIG_I2C_CADENCE=y
CONFIG_EEPROM_AT24=y

# Console
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# Security
CONFIG_RANDOMIZE_BASE=n

# Panic behaviour
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5

# Device tree overlay (needed for FPGA)
CONFIG_OF_OVERLAY=y
CONFIG_OF_DYNAMIC=y

# --- IIO core + DMA buffer support ---
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_BUFFER_DMAENGINE=y
CONFIG_IIO_BUFFER_HW_CONSUMER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGERED_BUFFER=y

# --- AXI DMA + ADI AXI ADC/DDS fabric cores (axi_ad9361, dmac) ---
CONFIG_DMADEVICES=y
CONFIG_AXI_DMAC=y
CONFIG_CF_AXI_ADC=y
CONFIG_CF_AXI_DDS=y

# --- AD9361/AD9364 RF transceiver SPI driver ---
CONFIG_AD9361=y

# --- AD7291 (FMCOMMS2/3 mezzanine temp/voltage monitor) ---
CONFIG_AD7291=y

# --- Uncomment below for debug builds only ---
# CONFIG_DEBUG_KERNEL=y
# CONFIG_DYNAMIC_DEBUG=y
# CONFIG_DEBUG_FS=y
# CONFIG_FTRACE=y
# CONFIG_CMDLINE_EXTEND=y
