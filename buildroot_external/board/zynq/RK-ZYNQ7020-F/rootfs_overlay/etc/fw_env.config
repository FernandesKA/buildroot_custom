# U-Boot environment location for fw_printenv/fw_setenv (libubootenv).
#
# The Zynq board code only supports FAT/EXT4/NOWHERE for SD boot, so the
# environment lives in the FAT boot partition (mmcblk0p1), mounted at /uboot.
# Matches the U-Boot config: ENV_IS_IN_FAT, redundant, ENV_SIZE=0x2000,
# ENV_FAT_FILE="uboot.env", ENV_FAT_FILE_REDUND="uboot-redund.env".
#
# Device                Offset   Env size
/uboot/uboot.env        0x0000   0x2000
/uboot/uboot-redund.env 0x0000   0x2000
